# SMTP Configuration for Email Sending
# SMTP Server (for Gmail use: smtp.gmail.com)
SMTP_SERVER=

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=

# SMTP Username (your email address)
SMTP_USER=

# SMTP Password (for Gmail use App Password, not regular password)
# For Gmail: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=

# Sender Email (usually same as SMTP_USER)
SENDER_EMAIL=